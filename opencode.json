{
  "$schema": "https://opencode.ai/config.json",

  "instructions": [
    "AGENTS.md",
    "docs/architecture.md",
    "docs/database.md",
    "docs/decisions.md",
    "docs/conventions.md"
  ],

  "mcp": {
    "supabase": {
      "type": "remote",
      "url": "https://mcp.supabase.com/mcp?project_ref=YOUR_SUPABASE_PROJECT_REF&features=database,docs",
      "enabled": true
    }
  },

  "permission": {
    "skill": {
      "project-context": "allow",
      "project-memory": "allow",
      "architecture": "allow",
      "database": "allow",
      "security": "allow",
      "testing": "allow",
      "code-review": "allow",
      "session-memory": "allow"
    }
  }
}